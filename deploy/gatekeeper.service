# /etc/systemd/system/gatekeeper.service
#
# Подготовка (один раз, от root):
#   useradd --system --home-dir /var/lib/gatekeeper --shell /usr/sbin/nologin gatekeeper
#   install -d -o gatekeeper -g gatekeeper -m 0750 /etc/gatekeeper
#   install -d -o gatekeeper -g gatekeeper -m 0700 /var/lib/gatekeeper
#
# Токен провайдера: файл 0400, который systemd передаёт шлюзу как credential, а не как
# переменную окружения (значение в EnvironmentFile видно в /proc/<pid>/environ):
#   install -o gatekeeper -g gatekeeper -m 0400 /dev/null /etc/gatekeeper/upstream-token
#   echo '123456:ABC...' > /etc/gatekeeper/upstream-token
# в config.toml:
#   [provider]
#   secret_file = "/run/credentials/gatekeeper.service/upstream-token"
#
# Команды управления (init, add-client, freeze, revoke, renew, renew-server, decoy-create)
# запускайте от пользователя gatekeeper, чтобы файлы не стали принадлежать root:
#   sudo -u gatekeeper /opt/gatekeeper/.venv/bin/gatekeeper freeze --id mybot
#
# ВНИМАНИЕ: юнит не проверялся на конкретном сервере. После установки посмотрите
#   systemd-analyze security gatekeeper
# и journalctl -u gatekeeper; при отказе запуска ослабляйте по одной настройке.

[Unit]
Description=gatekeeper API gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gatekeeper
Group=gatekeeper
Environment=GATEKEEPER_CONFIG_DIR=/etc/gatekeeper
Environment=GATEKEEPER_DATA_DIR=/var/lib/gatekeeper
# Токен — только через LoadCredential; несекретные настройки можно держать в env-файле.
LoadCredential=upstream-token:/etc/gatekeeper/upstream-token
EnvironmentFile=-/etc/gatekeeper/env
ExecStart=/opt/gatekeeper/.venv/bin/gatekeeper run
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=300
StartLimitBurst=5
RuntimeDirectory=gatekeeper
RuntimeDirectoryMode=0700

# Ограничения. Порт 8443 непривилегированный, поэтому capabilities не нужны.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @obsolete @debug @cpu-emulation
UMask=0077
# Пишем только журнал и данные; конфигурацию шлюз только читает.
ReadWritePaths=/var/lib/gatekeeper
ReadOnlyPaths=/etc/gatekeeper

[Install]
WantedBy=multi-user.target
